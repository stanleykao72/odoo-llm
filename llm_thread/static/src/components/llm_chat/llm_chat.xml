<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_thread.LLMChat">
        <div class="o_LLMChat d-flex h-100">
            <!-- Thread List Section -->
            <LLMChatSidebar record="llmChatView" />

            <!-- Chat Section -->
            <div class="o_LLMChat_content flex-grow-1 d-flex flex-column">
                <t t-if="hasActiveThread">
                    <LLMChatThread
                        record="activeThread"
                        threadView="llmChatView.threadView"
                    />
                </t>
                <t t-else="">
                    <div class="o_LLMChat_noThread d-flex align-items-center justify-content-center h-100">
                        <div class="text-center">
                            <div class="mb-4">
                                <i class="fa fa-comments fa-5x text-muted opacity-50" />
                            </div>
                            <h4 class="text-muted mb-3">Welcome to LLM Chat</h4>
                            <p class="text-muted mb-4">Select a conversation from the sidebar or create a new chat to get started</p>
                            <button class="btn btn-primary" t-on-click="llmChatView.llmChat.createNewThread">
                                <i class="fa fa-plus me-2" />
                                Start New Chat
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
