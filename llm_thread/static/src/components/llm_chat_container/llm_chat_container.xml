<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_thread.LLMChatContainer">
        <div class="o_LLMChatContainer h-100 d-flex flex-column">
            <!-- Loading state -->
            <div
                t-if="state.isLoading"
                class="o_LLMChatContainer_spinner d-flex flex-grow-1 align-items-center justify-content-center"
            >
                <div class="d-flex flex-column align-items-center">
                    <i class="o_LLMChatContainer_spinnerIcon fa fa-circle-o-notch fa-spin fa-2x mb-3 text-primary" />
                    <p class="text-muted">Loading LLM Chat...</p>
                </div>
            </div>

            <!-- Error state -->
            <div
                t-elif="state.error"
                class="o_LLMChatContainer_error d-flex flex-grow-1 align-items-center justify-content-center"
            >
                <div class="d-flex flex-column align-items-center text-center">
                    <i class="fa fa-exclamation-triangle fa-3x text-danger mb-3" />
                    <h5 class="text-danger">Error Loading Chat</h5>
                    <p class="text-muted mb-3" t-esc="state.error" />
                    <button class="btn btn-primary" t-on-click="initializeLLMChat">
                        <i class="fa fa-refresh me-2" />
                        Retry
                    </button>
                </div>
            </div>

            <!-- Main chat interface -->
            <LLMChat
                t-elif="state.isInitialized"
                record="llmChatView"
            />

            <!-- Fallback state -->
            <div
                t-else=""
                class="o_LLMChatContainer_empty d-flex flex-grow-1 align-items-center justify-content-center"
            >
                <div class="d-flex flex-column align-items-center text-center">
                    <i class="fa fa-comments fa-3x text-muted mb-3" />
                    <p class="text-muted">Initializing chat...</p>
                </div>
            </div>
        </div>
    </t>
</templates>
