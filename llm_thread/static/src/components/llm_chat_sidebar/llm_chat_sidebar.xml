<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_thread.LLMChatSidebar">
        <!-- Sidebar -->
        <div class="o_LLMChatSidebar o_DiscussSidebar d-flex flex-column overflow-auto o_Discuss_sidebar flex-shrink-0 h-100 pt-3 border-end bg-light">
            <!-- New Chat Button -->
            <div class="d-flex justify-content-center pb-3">
                <button
                    class="o_DiscussSidebar_startAMeetingButton btn btn-primary rounded"
                    t-on-click="_onClickNewChat"
                >
                    <i class="fa fa-plus me-2" />
                    <span>New Chat</span>
                </button>
            </div>

            <!-- Thread List -->
            <div class="o_LLMChatSidebar_threadList flex-grow-1 overflow-auto">
                <t t-if="threads.length > 0">
                    <div class="list-group list-group-flush">
                        <t t-foreach="threads" t-as="thread" t-key="thread.id">
                            <div
                                class="list-group-item list-group-item-action border-0 px-3 py-2 cursor-pointer"
                                t-att-class="isThreadActive(thread) ? 'active' : ''"
                                t-att-data-thread-id="thread.id"
                                t-on-click="_onClickThread"
                            >
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="fw-medium text-truncate" t-esc="getThreadDisplayName(thread)" />
                                        <small class="text-muted" t-esc="getThreadDate(thread)" />
                                    </div>
                                    <div class="flex-shrink-0 ms-2">
                                        <t t-if="isThreadActive(thread)">
                                            <i class="fa fa-comment text-primary" />
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="p-3 text-center text-muted">
                        <div class="mb-3">
                            <i class="fa fa-comments fa-3x text-muted" />
                        </div>
                        <p class="fw-medium">No conversations yet</p>
                        <p class="small">Click "New Chat" to start a conversation</p>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
