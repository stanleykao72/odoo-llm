<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_json_editor.JsonEditorField">
        <div class="o_field_json_editor">
            <t t-if="props.readonly">
                <pre class="json-view"><t t-esc="this.formatValue()" /></pre>
            </t>
            <t t-else="">
                <div t-ref="editor" class="json-editor-container">
                    <!-- Fallback for when JSONEditor isn't loaded -->
                    <textarea t-if="!state.editorInitialized" class="o_input form-control" 
                              t-att-value="this.formatValue()" 
                              t-on-change="(ev) => props.update(ev.target.value)"
                              rows="5"/>
                </div>
            </t>
        </div>
    </t>
</templates>
