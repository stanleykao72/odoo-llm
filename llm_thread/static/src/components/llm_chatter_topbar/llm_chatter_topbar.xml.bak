<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
    t-name="llm_thread.ChatterTopbar"
    t-inherit="mail.Chatter"
    t-inherit-mode="extension"
   
  >
        <!-- Insert AI button in the Chatter topbar area -->
        <xpath
      expr="//div[hasclass('o-mail-Chatter-topbar')]//button[hasclass('o-mail-Chatter-activity')]"
      position="after"
    >
            <!-- AI Chat Button inserted next to Activities -->
            <div class="o_ChatterTopbar_borderLeft ms-2" />
            <button
        t-attf-class="o_ChatterTopbar_button btn text-nowrap ms-2 {{ chatter.is_chatting_with_llm ? 'btn-primary o-active' : 'btn-light' }}"
        type="button"
        t-on-click="chatter.toggleLLMChat"
      >
                <span>AI</span>
            </button>
        </xpath>
    </t>
</templates>
