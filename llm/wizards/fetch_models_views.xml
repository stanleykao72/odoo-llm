<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_fetch_models_wizard" model="ir.ui.view">
        <field name="name">llm.fetch.models.wizard.form</field>
        <field name="model">llm.fetch.models.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Add count fields and line_ids to test -->
                    <group>
                        <field name="provider_id" readonly="1" string="Provider" />
                        <field name="model_count" readonly="1" string="Models Found" />
                        <field name="new_count" readonly="1" string="New Models" />
                        <field name="modified_count" readonly="1" string="Modified Models" />
                    </group>
                    <p>Test message: If you can see this, the wizard is working with count fields and proper line_ids.</p>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="1" delete="1">
                            <field name="name"/>
                            <field name="model_use"/>
                            <field name="status"/>
                            <field name="selected"/>
                        </list>
                    </field>
                </sheet>

                <footer>
                    <button
            string="Import Selected Models"
            name="action_confirm"
            type="object"
            class="btn-primary"
            data-hotkey="q"
          />
                    <button
            string="Cancel"
            class="btn-secondary"
            special="cancel"
            data-hotkey="z"
          />
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_fetch_models_wizard" model="ir.actions.act_window">
        <field name="name">Import Models</field>
        <field name="res_model">llm.fetch.models.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_llm_provider" />
        <field name="binding_view_types">form</field>
    </record>
</odoo>
